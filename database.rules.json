{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": "auth != null && data.val() === auth.uid",
      ".write": false,
      ".validate": "newData.isString()"
    },
    "cafeDennis": {
      "beans": {
        ".read": true,
        ".write": "auth != null && root.child('admins').val() === auth.uid",
        "$bean": {
          "votes": {
            ".write": "data.parent().exists() && newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() === 1) || (data.isNumber() && (newData.val() === data.val() + 1 || newData.val() === data.val() - 1 || (data.val() === 0 && newData.val() === 0))))",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      },
      "brandLogos": {
        ".read": true,
        ".write": "auth != null && root.child('admins').val() === auth.uid"
      },
      "brandNamesEn": {
        ".read": true,
        ".write": "auth != null && root.child('admins').val() === auth.uid"
      },
      "requests": {
        ".read": true,
        ".write": "auth != null && root.child('admins').val() === auth.uid",
        "$request": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['id','country','process','brand','comment','ts'])",
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "country": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "process": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "brand": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "comment": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "ts": {
              ".validate": "newData.isNumber() && ((auth != null && root.child('admins').val() === auth.uid) || (newData.val() <= now + 60000 && newData.val() >= now - 300000))"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
